{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS-Diagnostic-Room",
  "version": "0.1.0",
  "identifier": "com.local.ieltsdiagnostic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "雅思 AI 本地学习网页群",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": []
  }
}
